{
  "name": "ildp",
  "version": "1.0.0",
  "description": "Inclusive Leadership Digital Platform",
  "private": true,
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "dev": "npm run dev:backend & npm run dev:frontend",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "db:migrate": "npm run db:migrate --prefix backend",
    "db:seed": "npm run db:seed --prefix backend",
    "db:studio": "npm run db:studio --prefix backend",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f ildp-postgres",
    "setup": "npm run docker:up && npm run install:all && npm run db:migrate && npm run db:seed",
    "start": "npm run docker:up && npm run dev"
  },
  "keywords": ["ilm", "inclusive-leadership", "assessment", "agriculture"],
  "author": "",
  "license": "MIT"
}
