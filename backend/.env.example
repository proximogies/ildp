DATABASE_URL="postgresql://user:password@localhost:5432/ildp_db"
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"
PORT=5000
NODE_ENV=development

# File Storage (local or S3)
STORAGE_DRIVER=local
LOCAL_UPLOAD_PATH=./uploads

# S3 (optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BUCKET_NAME=

# Brevo (Sendinblue) SMTP — https://app.brevo.com/settings/keys/smtp
# Use SMTP credentials, NOT the API key
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your-brevo-login-email@example.com
BREVO_SMTP_KEY=your-brevo-smtp-key

# Sender address (must be a verified sender in Brevo)
MAIL_FROM=noreply@yourdomain.com

# Frontend URL (for CORS and email links)
FRONTEND_URL=http://localhost:5173
