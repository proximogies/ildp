DATABASE_URL="postgresql://user:password@localhost:5432/ildp_db"
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"
PORT=5000
NODE_ENV=development

# File Storage (local or S3)
STORAGE_DRIVER=local
LOCAL_UPLOAD_PATH=./uploads

# S3 (optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BUCKET_NAME=

# Brevo (Sendinblue) Transactional Email API — https://app.brevo.com/settings/keys/api
# Use the API key, NOT SMTP credentials (SMTP is blocked on Render free tier)
BREVO_API_KEY=your-brevo-api-key

# Sender address and name (must be a verified sender in Brevo)
MAIL_FROM=noreply@yourdomain.com
MAIL_FROM_NAME=ILDP

# Frontend URL (for CORS and email links)
FRONTEND_URL=http://localhost:5173
